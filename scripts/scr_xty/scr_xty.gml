function scr_xty(){
	switch (room) {
		case Game1: return seq_1t2; break;
		case Game2: return seq_2t3; break;
		case Game3: return seq_3t4; break;
		case Game4: return seq_4t5; break;
		case Game5: return seq_5t6; break;
		case Game6: return seq_6t7; break;
		case Game7: return seq_7t8; break;
		case Game8: return seq_8t9; break;
		case Game9: return seq_9t10; break;
		case Game10: return seq_10t11; break;
		case Game11: return seq_11t12; break;
		case Game12: return seq_12t13; break;
		case Game13: return seq_13t14; break;
		case Game14: return seq_14t15; break;
	}
}